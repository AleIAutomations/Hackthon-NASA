# Copie para .env e preencha localmente. NUNCA commitar o .env.
# Login NASA Earthdata (gratuito): https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Alternativa ao par usuario/senha: token Bearer do Earthdata
ASF_EDL_TOKEN=

# Se true, o backend serve o cache local sem tocar na rede
DEMO_CACHE_FIRST=true

# NASA POWER (publica, sem chave)
POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Frontend
VITE_API_URL=http://localhost:8000
